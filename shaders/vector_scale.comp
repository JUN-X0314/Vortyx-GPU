#version 450

// Vortyx Phase 10: Vector Scale compute kernel (elementwise, one input).
// Computes C[i] = A[i] * scalar for i in [0, count).
//
// One workgroup processes LOCAL_SIZE_X elements; the dispatch uses
// ceil(count / LOCAL_SIZE_X) workgroups and this guard rejects the
// out-of-range invocations of the last workgroup.
//
// Binding note (honest, documented in the Vulkan backend): the descriptor
// layout is shared by every elementwise kernel, so binding 1 (InB) is still
// bound for scale dispatches — the backend aliases the PRIMARY INPUT buffer
// into that slot as a placeholder. This kernel NEVER reads it.
//
// Push-constant block: the SHARED elementwise layout; `scalar` is the scale
// factor (int32). Integer semantics: int multiplication is exact modulo
// 2^32 (low 32 bits of the true product, two's complement), identical on
// every backend — cross-backend results are bit-exact by construction,
// overflow included.
//
// Regenerate SPIR-V (requires glslangValidator or glslc from the Vulkan SDK):
//   glslangValidator -V --target-env vulkan1.0 shaders/vector_scale.comp -o shaders/vector_scale.spv
// The compiled SPIR-V is embedded into the binary via
// src/core/compute/vector_scale_spv.hpp (see scripts/embed_spv.py).

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer InA { int in_a[]; };
layout(std430, binding = 1) buffer InB { int in_b[]; };  // bound as placeholder; NEVER read here
layout(std430, binding = 2) buffer OutC { int out_c[]; };

layout(push_constant) uniform PushConstants {
    uint count;  // number of elements (uint32)
    int scalar;  // scale factor (int32)
} pc;

void main() {
    const uint index = gl_GlobalInvocationID.x;
    if (index < pc.count) {
        out_c[index] = in_a[index] * pc.scalar;
    }
}
