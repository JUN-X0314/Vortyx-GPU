# ============================================================================
# Vortyx platform API — environment template (Phase 11, extended in Phase 15).
# Copy to .env.local for local development. REAL VALUES ARE NEVER COMMITTED:
# .env / .env.local / .env.production are git-ignored (see repository
# .gitignore). Every variable below is documented in docs/platform/api-env.md
# (see docs/platform/security.md for the threat model).
# ============================================================================

# --- Store selection (server-side) ------------------------------------------
# memory   = local/mock in-process store (default; local dev and tests ONLY,
#            persists nothing, never for deployment)
# supabase = the real backend (requires the two settings below and the
#            migrations in platform/supabase/migrations applied in order)
VORTYX_STORE=memory

# --- Supabase project (server-side config; required when VORTYX_STORE=supabase)
# Project URL — not a secret, but only used server-side.
SUPABASE_URL=
# Publishable-by-design anon key. Safety comes from Row Level Security, NOT
# from key secrecy. Still only used server-side in this API.
SUPABASE_ANON_KEY=

# --- SERVER-ONLY SECRETS -----------------------------------------------------
# Bypasses RLS. NEVER expose to any client, NEVER commit, NEVER log.
# Phase 15 uses it ONLY for the worker-protocol paths and reconciliation
# (claim/heartbeat/complete run outside any user's identity).
SUPABASE_SERVICE_ROLE_KEY=

# The native worker agent's bearer token (vortyx_worker sends it as
# "Authorization: Bearer <token>"). Unset = the worker protocol endpoints
# report 503 (the boundary is disabled, never faked). Generate one with:
#   openssl rand -hex 32
VORTYX_WORKER_TOKEN=

# The /api/internal/reconcile secret (also accepted: the worker token; on
# Vercel Cron, CRON_SECRET is sent as its Authorization bearer automatically).
VORTYX_RECONCILE_TOKEN=

# --- Browser access (Phase 15 web console) -----------------------------------
# The ONE origin allowed to call this API cross-origin (the deployed web
# console's origin, e.g. https://vortyx-web.vercel.app). Empty/unset = no
# CORS header (same-origin deployments only). Never use "*" — the API is
# credential-bearing.
VORTYX_ALLOWED_ORIGIN=

# --- Local development -------------------------------------------------------
PORT=3000
