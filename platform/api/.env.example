# ============================================================================
# Vortyx platform API — environment template (Phase 11).
# Copy to .env.local for local development. REAL VALUES ARE NEVER COMMITTED:
# .env / .env.local / .env.production are git-ignored (see repository
# .gitignore). Every variable below is documented in docs/platform/api-env.md
# (see docs/platform/security.md for the threat model).
# ============================================================================

# --- Store selection (server-side) ------------------------------------------
# memory   = local/mock in-process store (default; local dev and tests ONLY,
#            persists nothing, never for deployment)
# supabase = the real backend (requires the two settings below)
VORTYX_STORE=memory

# --- Supabase project (server-side config; required when VORTYX_STORE=supabase)
# Project URL — not a secret, but only used server-side in Phase 11.
SUPABASE_URL=
# Publishable-by-design anon key. Safety comes from Row Level Security, NOT
# from key secrecy. Still only used server-side in this phase.
SUPABASE_ANON_KEY=

# --- SERVER-ONLY SECRET ------------------------------------------------------
# Bypasses RLS. NEVER expose to any client, NEVER commit, NEVER log.
# Not used by any Phase 11 endpoint; reserved for future privileged
# server-side jobs. Presence is detected for readiness reporting only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Local development -------------------------------------------------------
PORT=3000
