*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# IDE files
.vs/
.vscode/
.idea/

# Environment / secret files — real keys are NEVER committed
.env
.env.*
!.env.example

# Node (platform/api and the deployment root)
node_modules/

# Phase 17: local Vercel build artifacts are never committed. The deployment
# container's bundled entry (api/[...route].ts overwritten in place by the
# buildCommand) lives only in the build workspace.
.vercel/

# test output & cache
Testing/
.cache/

# Phase 15: API-side runtime env files are still never committed. Since
# Phase 16.0.1 the WEB console's publishable runtime config
# (platform/web/js/config.js) IS committed deliberately: it carries only
# the Supabase project URL, the publishable anon key and the API base URL
# (all public by design; data safety comes from RLS). A service-role key,
# worker token, DB password or any other secret must NEVER be placed there.
platform/api/.env
platform/api/.env.local
platform/api/.env.production
